{
  "version": 1,
  "author": "CoCIS Smart Control",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },

    { "type": "wokwi-pir-motion-sensor", "id": "pir1", "top": -150, "left": -200, "attrs": {} },
    { "type": "wokwi-pir-motion-sensor", "id": "pir2", "top": -50, "left": -200, "attrs": {} },

    { "type": "wokwi-pushbutton", "id": "btn_ok", "top": 100, "left": -200, "attrs": { "color": "green", "label": "Entry OK" } },
    { "type": "wokwi-pushbutton", "id": "btn_bad", "top": 170, "left": -200, "attrs": { "color": "red", "label": "Entry Bad" } },
    { "type": "wokwi-pushbutton", "id": "btn_exit", "top": 240, "left": -200, "attrs": { "color": "blue", "label": "Exit" } },

    { "type": "wokwi-servo", "id": "servo1", "top": 300, "left": 0, "attrs": {} },
    { "type": "wokwi-buzzer", "id": "bz1", "top": -140, "left": 130, "attrs": { "volume": "0.1" } },

    { "type": "wokwi-led", "id": "led_green", "top": 330, "left": 200, "attrs": { "color": "green", "label": "Door OK" } },
    { "type": "wokwi-led", "id": "led_red", "top": 330, "left": 250, "attrs": { "color": "red", "label": "Denied" } },
    { "type": "wokwi-led", "id": "led_room1", "top": 330, "left": 300, "attrs": { "color": "yellow", "label": "Room1" } },
    { "type": "wokwi-led", "id": "led_room2", "top": 330, "left": 350, "attrs": { "color": "blue", "label": "Room2" } },

    { "type": "wokwi-resistor", "id": "r_green", "top": 270, "left": 195, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_red", "top": 270, "left": 245, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_room1", "top": 270, "left": 295, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_room2", "top": 270, "left": 345, "rotate": 90, "attrs": { "value": "220" } },

    { "type": "board-ssd1306", "id": "oled1", "top": -150, "left": 300, "attrs": { "i2cAddress": "0x3c" } },

    { "type": "wokwi-microsd-card", "id": "sd1", "top": 40, "left": 520, "attrs": {} },
    { "type": "chip-rfid-rc522", "id": "rfid1", "top": 210, "left": 520, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn_card", "top": 340, "left": 520, "attrs": { "color": "white", "label": "Tap Card" } }
  ],
  "connections": [
    ["esp:TX", "$serialMonitor:RX", "", []],
    ["esp:RX", "$serialMonitor:TX", "", []],

    ["pir1:VCC", "esp:5V", "red", []],
    ["pir1:GND", "esp:GND.1", "black", []],
    ["pir1:OUT", "esp:34", "violet", []],
    ["pir2:VCC", "esp:5V", "red", []],
    ["pir2:GND", "esp:GND.1", "black", []],
    ["pir2:OUT", "esp:35", "violet", []],

    ["btn_ok:1.l", "esp:18", "green", []],
    ["btn_ok:2.l", "esp:GND.1", "black", []],
    ["btn_bad:1.l", "esp:19", "red", []],
    ["btn_bad:2.l", "esp:GND.1", "black", []],
    ["btn_exit:1.l", "esp:21", "blue", []],
    ["btn_exit:2.l", "esp:GND.1", "black", []],

    ["servo1:V+", "esp:5V", "red", []],
    ["servo1:GND", "esp:GND.1", "black", []],
    ["servo1:PWM", "esp:13", "orange", []],

    ["bz1:1", "esp:GND.2", "black", []],
    ["bz1:2", "esp:32", "gold", []],

    ["esp:25", "r_green:1", "green", []],
    ["r_green:2", "led_green:A", "green", []],
    ["led_green:C", "esp:GND.2", "black", []],
    ["esp:26", "r_red:1", "red", []],
    ["r_red:2", "led_red:A", "red", []],
    ["led_red:C", "esp:GND.2", "black", []],
    ["esp:27", "r_room1:1", "yellow", []],
    ["r_room1:2", "led_room1:A", "yellow", []],
    ["led_room1:C", "esp:GND.2", "black", []],
    ["esp:14", "r_room2:1", "blue", []],
    ["r_room2:2", "led_room2:A", "blue", []],
    ["led_room2:C", "esp:GND.2", "black", []],

    ["oled1:VCC", "esp:3V3", "red", []],
    ["oled1:GND", "esp:GND.3", "black", []],
    ["oled1:SDA", "esp:23", "blue", []],
    ["oled1:SCL", "esp:22", "green", []],

    ["sd1:VCC", "esp:5V", "red", []],
    ["sd1:GND", "esp:GND.2", "black", []],
    ["sd1:CS", "esp:5", "cyan", []],
    ["sd1:SCK", "esp:15", "magenta", []],
    ["sd1:DI", "esp:16", "brown", []],
    ["sd1:DO", "esp:17", "gray", []],

    ["rfid1:3V3", "esp:3V3", "red", []],
    ["rfid1:GND", "esp:GND.3", "black", []],
    ["rfid1:SDA", "esp:2", "orange", []],
    ["rfid1:SCK", "esp:4", "blue", []],
    ["rfid1:MOSI", "esp:12", "purple", []],
    ["rfid1:MISO", "esp:33", "green", []],
    ["rfid1:RST", "esp:3V3", "red", []],

    ["btn_card:1.l", "rfid1:CARD", "white", []],
    ["btn_card:2.l", "rfid1:GND", "black", []]
  ],
  "dependencies": {}
}
